    <!-- Lazy load noncritical scripts - optimized for better TBT -->
    <script>
      function loadLazyScripts() {
        const lazyScripts = [];
        
          lazyScripts.push("//aimsindustrial.com.au/cdn/shop/t/123/assets/quick-view.js?v=164466835857832542011790747164");
        
        
          lazyScripts.push("//aimsindustrial.com.au/cdn/shop/t/123/assets/compare.js?v=152224050373430531111790747164");
        

        lazyScripts.forEach(src => {
          const s = document.createElement('script');
          s.src = src;
          s.defer = true;
          s.async = true;
          document.body.appendChild(s);
        });
      }

      if (window.requestIdleCallback) {
        requestIdleCallback(loadLazyScripts, { timeout: 2000 });
      } else if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadLazyScripts);
      } else {
        loadLazyScripts();
      }



    </script>

    




