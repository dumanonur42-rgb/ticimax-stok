                      <script>
  function clearCart() {
    fetch('/cart/clear.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to clear cart');
      }
      return response.json();
    })
    .then(data => {
      console.log('Cart cleared:', data);
      // Optional: reload page or redirect to cart page
      location.reload();
    })
    .catch(error => {
      console.error('Error:', error);
    });
  }
</script>

<!-- Example button to trigger -->
<button onclick="clearCart()">Clear Cart</button><cart-items class="flex-grow">
