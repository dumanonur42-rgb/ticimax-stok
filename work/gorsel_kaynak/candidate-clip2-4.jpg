<style>
  #mp-chat-btn { position: fixed; bottom: 24px; right: 24px; width: 56px; height: 56px; background: #ffd600; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,0.2); z-index: 9999; clip-path: polygon(8px 0%, 100% 0%, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0% 100%, 0% 8px); }
  #mp-chat-btn:hover { background: #e6c200; }
  #mp-chat-btn svg { width: 26px; height: 26px; fill: none; stroke: #111; stroke-width: 2; }
  #mp-badge { position: fixed; bottom: 62px; right: 18px; width: 20px; height: 20px; background: #e53935; border-radius: 50%; border: 2px solid #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; font-weight: 700; animation: mpbadge 1.5s infinite; z-index: 10000; }
  @keyframes mpbadge { 0%,100% { transform: scale(1); } 50% { transform: scale(1.3); } }
  #mp-chat-box { position: fixed; bottom: 90px; right: 24px; width: 320px; height: 460px; background: #fff; display: none; flex-direction: column; overflow: hidden; border: 1px solid #ffd600; border-top: 3px solid #ffd600; z-index: 9999; font-family: Arial, sans-serif; }
  #mp-chat-box.open { display: flex; }
  .mp-head { background: #111; padding: 12px 14px; display: flex; align-items: center; gap: 10px; border-bottom: 2px solid #ffd600; }
  .mp-av { width: 34px; height: 34px; background: #ffd600; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 900; color: #111; flex-shrink: 0; }
  .mp-info p:first-child { font-size: 13px; font-weight: 700; color: #fff; margin: 0; text-transform: uppercase; }
  .mp-info p:last-child { font-size: 11px; color: #ffd600; margin: 0; display: flex; align-items: center; gap: 4px; }
  .mp-online { width: 6px; height: 6px; background: #4caf50; border-radius: 50%; display: inline-block; }
  .mp-close-btn { margin-left: auto; background: none; border: none; color: #666; cursor: pointer; font-size: 20px; line-height: 1; }
  .mp-close-btn:hover { color: #ffd600; }
  .mp-msgs { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: #f5f5f5; }
  .mp-msgs::-webkit-scrollbar { width: 4px; }
  .mp-msgs::-webkit-scrollbar-thumb { background: #ffd600; }
  .mp-msg { max-width: 85%; padding: 8px 12px; font-size: 13px; line-height: 1.6; word-break: break-word; white-space: pre-line; }
  .mp-bot { background: #fff; border: 1px solid #e0e0e0; border-left: 3px solid #ffd600; color: #222; align-self: flex-start; }
  .mp-user { background: #fff; border: 1px solid #e0e0e0; border-right: 3px solid #aaa; color: #333; align-self: flex-end; }
  .mp-time { font-size: 10px; margin-top: 3px; color: #999; }
  .mp-user .mp-time { text-align: right; }
  .mp-typing { display: flex; gap: 4px; padding: 10px 12px; background: #fff; border: 1px solid #e0e0e0; border-left: 3px solid #ffd600; align-self: flex-start; }
  .mp-d { width: 6px; height: 6px; background: #ffd600; border-radius: 50%; animation: mpb 1.2s infinite; }
  .mp-d:nth-child(2) { animation-delay: 0.2s; }
  .mp-d:nth-child(3) { animation-delay: 0.4s; }
  @keyframes mpb { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }
  .mp-sugs { padding: 8px 10px 4px; display: flex; gap: 6px; flex-wrap: wrap; background: #fff; border-top: 1px solid #eee; }
  .mp-sug { background: transparent; border: 1px solid #ffd600; color: #111; padding: 4px 10px; font-size: 11px; cursor: pointer; font-weight: 700; text-transform: uppercase; }
  .mp-sug:hover { background: #ffd600; color: #111; }
  .mp-inp-wrap { padding: 10px; border-top: 1px solid #e0e0e0; display: flex; gap: 8px; background: #fff; }
  .mp-inp { flex: 1; border: 1px solid #ddd; background: #fff; color: #222; padding: 8px 12px; font-size: 13px; outline: none; font-family: Arial, sans-serif; }
  .mp-inp:focus { border-color: #ffd600; }
  .mp-inp::placeholder { color: #aaa; }
  .mp-send { width: 36px; height: 36px; background: #ffd600; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .mp-send:hover { background: #e6c200; }
  .mp-send svg { width: 14px; height: 14px; fill: none; stroke: #111; stroke-width: 2.5; }
</style>
<button id="mp-chat-btn" onclick="mpToggle()" title="Открыть чат" aria-label="Открыть чат">
  <svg id="mp-ico1" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
  <svg id="mp-ico2" viewBox="0 0 24 24" style="display:none"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
  <div id="mp-badge">1</div>
</button>
<div id="mp-chat-box">
  <div class="mp-head">
    <div class="mp-av">МП</div>
    <div class="mp-info">
      <p>Мир Привода</p>
      <p><span class="mp-online"></span> Онлайн-консультант</p>
    </div>
    <button class="mp-close-btn" onclick="mpToggle()" aria-label="Закрыть">×</button>
  </div>
  <div class="mp-msgs" id="mp-msgs">
    <div class="mp-msg mp-bot">Здравствуйте! Задайте вопрос по товарам - отвечу мгновенно. Что вас интересует?<div class="mp-time">сейчас</div></div>
  </div>
  <div class="mp-sugs" id="mp-sugs">
    <button class="mp-sug" onclick="mpQ('Какие муфты есть?')">Муфты</button>
    <button class="mp-sug" onclick="mpQ('Какие подшипники есть?')">Подшипники</button>
    <button class="mp-sug" onclick="mpQ('Как сделать заказ?')">Заказать</button>
  </div>
  <div class="mp-inp-wrap">
    <input class="mp-inp" id="mp-inp" placeholder="Введите вопрос..." onkeydown="if (event.key === 'Enter') mpSend();" />
    <button class="mp-send" onclick="mpSend()" aria-label="Отправить">
      <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
    </button>
  </div>
</div>
<script>
  (function () {
    var WH = "https://api.mirprivoda.ru/webhook/79a31f49-a258-42b2-89cb-e753661c2c9b";
    var SID = "mp_" + Math.random().toString(36).substr(2, 9);
    window.mpToggle = function () {
      var b = document.getElementById("mp-chat-box");
      var open = b.classList.toggle("open");
      document.getElementById("mp-ico1").style.display = open ? "none" : "block";
      document.getElementById("mp-ico2").style.display = open ? "block" : "none";
      if (open) {
        document.getElementById("mp-badge").style.display = "none";
        document.getElementById("mp-inp").focus();
      }
    };
    window.mpQ = function (t) {
      document.getElementById("mp-sugs").style.display = "none";
      mpMsg(t);
    };
    window.mpSend = function () {
      var i = document.getElementById("mp-inp");
      var t = i.value.trim();
      if (!t) return;
      i.value = "";
      document.getElementById("mp-sugs").style.display = "none";
      mpMsg(t);
    };
    function gt() {
      var d = new Date();
      return d.getHours() + ":" + (d.getMinutes() < 10 ? "0" : "") + d.getMinutes();
    }
    function esc(t) {
      return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    function mpMsg(t) {
      var m = document.getElementById("mp-msgs");
      m.innerHTML += '<div class="mp-msg mp-user">' + esc(t) + '<div class="mp-time">' + gt() + "</div></div>";
      var ty = document.createElement("div");
      ty.className = "mp-typing";
      ty.id = "mp-ty";
      ty.innerHTML = '<div class="mp-d"></div><div class="mp-d"></div><div class="mp-d"></div>';
      m.appendChild(ty);
      m.scrollTop = m.scrollHeight;
      fetch(WH, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: t, sessionId: SID }),
      })
        .then(function (r) { return r.text(); })
        .then(function (txt) {
          var el = document.getElementById("mp-ty");
          if (el) el.remove();
          var rep = txt;
          try {
            var j = JSON.parse(txt);
            rep = j.output || j.text || j.response || txt;
          } catch (e) {}
          rep = esc(rep);
          m.innerHTML += '<div class="mp-msg mp-bot">' + rep + '<div class="mp-time">' + gt() + "</div></div>";
          m.scrollTop = m.scrollHeight;
        })
        .catch(function () {
          var el = document.getElementById("mp-ty");
          if (el) el.remove();
          m.innerHTML += '<div class="mp-msg mp-bot">Нет соединения. Попробуйте позже.<div class="mp-time">' + gt() + "</div></div>";
          m.scrollTop = m.scrollHeight;
        });
    }
  })();
</script>
	</body>
</html>

